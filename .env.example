# --- TELEGRAM BOT & RBAC GOVERNANCE ---
BOT_TOKEN=TGbot token # from @BotFather
BOT_OWNER_ID=123456789 # Primary Telegram Superadmin / Host Machine Owner ID
SUPER_ADMINS=123456789 # Optional comma-separated Superadmin user IDs (e.g. 123456789,987654321)
DEFAULT_LANGUAGE=en #ru, en, ar, es, fr, de, it, pt, zh, ja, ko, he - available languahes codes, update via languages.py
# --- DATABASE ---
DB_HOST=your database host #or use "db" if you are using docker-compose
DB_PORT=your database port
DB_USER=your database user
DB_PASSWORD=your database password
DB_NAME=your database name
# --- REDIS ---
REDIS_HOST=your redis host
REDIS_PORT=your redis port
# --- API & PARSING---
NOMINATIM_URLS=your nominatim urls separated by commas #OR URLS. DEAFULT: https://nominatim.openstreetmap.org/search
WIKIMEDIA_API_URL=your wikimedia api url

# --- LOGIC LIMITS ---
REGIONS={Region_name: [City1, City2, ...], ...} #RECOMMENDED: put that list in "config.py" file, because it can be very long and hard to read in .env file. 
LIMITS={"City_name": limit, ... } #RECOMMENDED: put that list in "config.py" file, because it can be very long and hard to read in .env file.
DEFAULT_LIMIT=your default limit for cities not specified in LIMITS